# Development deployment template.
# Store real values in GitHub environment secrets or the host secret manager.

SECRET_KEY=replace-with-dev-secret
APP_ENV=dev
DEBUG=False
ALLOWED_HOSTS=dev.example.com
CSRF_TRUSTED_ORIGINS=https://dev.example.com

USE_SQLITE=False
DB_NAME=nfl_squares_dev
DB_USER=nfl_squares_dev
DB_PASSWORD=replace-with-dev-db-password
DB_HOST=replace-with-dev-db-host
DB_PORT=5432
DB_CONN_MAX_AGE=60
DATABASE_URL=

SITE_URL=https://dev.example.com

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ADMIN_OAUTH_STAFF_EMAILS=
ADMIN_OAUTH_STAFF_DOMAINS=
ADMIN_OAUTH_SUPERUSER_EMAILS=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=NFL Squares Dev <noreply@example.com>
SERVER_EMAIL=NFL Squares Dev Errors <noreply@example.com>
EMAIL_TIMEOUT=10
ADMIN_EMAILS=
PRIVACY_CONTACT_EMAIL=
DATA_RETENTION_DAYS=30

MAX_SQUARES_PER_PARTICIPANT=10
CLAIM_COOLDOWN_SECONDS=2
ESPN_SCOREBOARD_URL=https://site.api.espn.com/apis/site/v2/sports/football/nfl/scoreboard
ESPN_REQUEST_TIMEOUT=10
LOG_LEVEL=INFO
